# Änderungs-Ermittlung ohne „unverändert“-Zeilen
def compute_changes(cur: Dict[str, Any], prop: Dict[str, Any]) -> List[Tuple[str, str, str]]:
    """
    Liefert Liste geänderter Felder als (label, alt, neu). Nur wenn wirklich unterschiedlich.
    """
    changes: List[Tuple[str, str, str]] = []

    def differ(a: Optional[str], b: Optional[str]) -> bool:
        return (b is not None) and (str(a or "").strip() != str(b or "").strip())

    if differ(cur.get("q"), prop.get("q")):
        changes.append(("Frage", str(cur.get("q") or ""), str(prop.get("q") or "")))

    cur_a = cur.get("a") or [None, None, None, None]
    for i, key in enumerate(["a1", "a2", "a3", "a4"], start=1):
        if differ(cur_a[i-1], prop.get(key)):
            changes.append((f"A{i}", str(cur_a[i-1] or ""), str(prop.get(key) or "")))

    if prop.get("correct") is not None and cur.get("correct") != prop.get("correct"):
        changes.append(("Richtig", str(cur.get("correct")), str(prop.get("correct"))))

    return changes

def _has_answer_changes(cur: Dict[str, Any], prop: Dict[str, Any]) -> bool:
    cur_a = cur.get("a") or [None, None, None, None]
    for i, key in enumerate(["a1", "a2", "a3", "a4"], start=1):
        if prop.get(key) is not None and (str(cur_a[i-1] or "").strip() != str(prop.get(key) or "").strip()):
            return True
    return prop.get("correct") is not None and cur.get("correct") != prop.get("correct")

def _is_question_change_only(cur: Dict[str, Any], prop: Dict[str, Any], status: str) -> bool:
    if (status or "").lower() == "drop":
        return False
    if prop.get("q") is None:
        return False
    if _has_answer_changes(cur, prop):
        return False
    return str(cur.get("q") or "").strip() != str(prop.get("q") or "").strip()

def _is_improvement(entry: Dict[str, Any], current: Dict[str, Any]) -> bool:
    status = (entry.get("status") or "").lower()
    prop = entry.get("proposal") or {}
    if status not in ("", "ok"):
        return True
    changes = compute_changes(current, prop)
    return len(changes) > 0

# Anzeige
def print_one_question_step(row: Dict[str, Any], entry: Dict[str, Any], is_duplicate_replacement: bool = False) -> None:
    q_current_map = {q["index"]: q for q in extract_questions(row)}
    idx = entry.get("index")
    cur = q_current_map.get(idx, None)
    pb = entry.get("proposal") or {}

    print("\n" + "=" * 80)
    prefix = "🔁 Duplikat-Ersatz" if is_duplicate_replacement else "🧩 Datensatz"
    header = f"{CYAN}{prefix} · ID {row.get('id')} · Frage {idx}{RESET}"
    print(header)
    print(f"{YELLOW}🏷️ Titel:{RESET} {row.get('Titel')}")
    print(f"{YELLOW}🗣️ Sprache:{RESET} {row.get('Sprache')}   {YELLOW}🎯 Level:{RESET} {row.get('level')}")
    if row.get("Beschreibung"):
        print(f"{YELLOW}📝 Beschreibung:{RESET} {row.get('Beschreibung')}")
    print("-" * 80)
    if cur:
        print(f"{BLUE}🔎 Aktuell:{RESET}")
        print(f"   Frage: {cur.get('q')}")
        print(f"   A1: {cur['a'][0]}")
        print(f"   A2: {cur['a'][1]}")
        print(f"   A3: {cur['a'][2]}")
        print(f"   A4: {cur['a'][3]}")
        print(f"   Richtig: {cur.get('correct')}")
    print("-" * 80)
    print(f"{BLUE}🛠️ Vorschlag:{RESET}")
    if entry.get("status"):
        print(f"   Status: {entry.get('status')}")
    if entry.get("reason"):
        print(f"   Grund: {entry.get('reason')}")

    changes = compute_changes(cur or {"a": [None, None, None, None]}, pb)
    if changes:
        for label, old, new in changes:
            if label == "Richtig":
                if old not in ("", "None"):
                    print(f"   {RED}❌ {label} (alt): {old}{RESET}")
                print(f"   {GREEN}✅ {label} (neu): {new}{RESET}")
            else:
                if str(old).strip():
                    print(f"   {RED}❌ {label} (alt): {old}{RESET}")
                print(f"   {GREEN}✅ {label} (neu): {new}{RESET}")
    else:
        print("   Keine konkreten Änderungen erkannt.")

    print("=" * 80)

def log_proposal_step(row_id: int, entry: Dict[str, Any], row: Dict[str, Any]) -> str:
    path = os.path.join(LOG_DIR, f"{row_id}-q{entry.get('index')}.md")
    with open(path, "w", encoding="utf-8") as f:
        f.write(f"# Änderungsprotokoll ID {row_id} · Frage {entry.get('index')}\n\n")
        f.write("## Vorschlag (JSON)\n\n```json\n")
        f.write(json.dumps(entry, ensure_ascii=False, indent=2))
        f.write("\n```\n\n## Original (gekürzt)\n\n```json\n")
        qmap = {q["index"]: q for q in extract_questions(row)}
        cur = qmap.get(entry.get("index"))
        f.write(json.dumps(cur, ensure_ascii=False, indent=2))
        f.write("\n```\n")
    return path

def prompt_yes_no_quit(msg: str) -> str:
    if AUTO_MODE:
        return "j"
    while True:
        ans = input(f"{msg} [j/n/q] ").strip().lower()
        if ans == "":
            return "j"
        if ans in ("j", "n", "q"):
            return ans

# Dedupe
def find_duplicate_groups(questions: List[Dict[str, Any]], threshold: float) -> List[List[int]]:
    items = [(q["index"], norm_text(q.get("q"))) for q in questions if not is_blank(q.get("q"))]
    groups: List[List[int]] = []
    used: set = set()
    for i in range(len(items)):
        idx_i, ti = items[i]
        if idx_i in used:
            continue
        group = [idx_i]
        for j in range(i + 1, len(items)):
            idx_j, tj = items[j]
            if idx_j in used:
                continue
            if ti and tj and sim(ti, tj) >= threshold:
                group.append(idx_j)
        if len(group) > 1:
            for gidx in group:
                used.add(gidx)
            groups.append(group)
    return groups

# Main
def main():
    parser = argparse.ArgumentParser(description="QA-Update Supabase mit DeepSeek")
    parser.add_argument("--table", default=DEFAULT_TABLE)
    parser.add_argument("--limit", type=int, default=20)
    parser.add_argument("--offset", type=int, default=0)
    parser.add_argument("--filter", default=None, help="Feld=Wert")
    parser.add_argument("--only-id", type=int, default=None)
    parser.add_argument("--reset-secrets", action="store_true", help="Erstellt leere secrets.json + secrets.example.json und beendet.")
    parser.add_argument("--deepseek-key", default=None, help="Optional: DEEPSEEK_API_KEY setzen und in secrets.json speichern (lokal).")
    parser.add_argument("--max-questions", type=int, default=40)
    parser.add_argument("--dedupe", action="store_true", default=True)
    parser.add_argument("--dedupe-threshold", type=float, default=0.9)
    parser.add_argument("--auto", action="store_true", help="Automatischer Durchlauf ohne Bestätigungen")
    args = parser.parse_args()

    secrets = load_secrets(reset=args.reset_secrets)

    global AUTO_MODE
    AUTO_MODE = bool(args.auto)
    if not AUTO_MODE:
        try:
            sel = input("Automatisch durchlaufen ohne Einzelfragen? [j/N] ").strip().lower()
            AUTO_MODE = (sel == "j")
        except Exception:
            AUTO_MODE = False

    if args.deepseek_key:
        # Key bewusst nur lokal speichern, niemals committen (.gitignore).
        secrets["DEEPSEEK_API_KEY"] = args.deepseek_key.strip()
        try:
            write_file(SECRETS_PATH, secrets)
            print(f"DeepSeek-Key lokal gespeichert: {mask(secrets['DEEPSEEK_API_KEY'])}")
        except Exception as e:
            print(f"{RED}Konnte secrets.json nicht schreiben: {e}{RESET}")

    table = args.table
    sb_url = secrets["SUPABASE_URL"]
    sb_key = secrets["SUPABASE_KEY"]
    ds_base = secrets["DEEPSEEK_BASE_URL"]
    ds_key = secrets["DEEPSEEK_API_KEY"]
    ds_model = secrets["DEEPSEEK_MODEL"]

    # Interaktive Auswahl: Anzahl oder alle
    try:
        sel_count = input("Wie viele Datensätze verarbeiten? Zahl eingeben oder 'a' für alle: ").strip().lower()
    except Exception:
        sel_count = ""

    process_all = (sel_count == "a")
    try:
        requested_count = int(sel_count) if sel_count and not process_all else None
    except ValueError:
        requested_count = None

    params: Dict[str, str] = {}
    rows: List[Dict[str, Any]] = []
    row_iter = None

    # Optionaler Filter
    filter_field = None
    filter_value = None
    if args.filter and "=" in args.filter:
        filter_field, filter_value = args.filter.split("=", 1)
        filter_field = filter_field.strip()
        filter_value = filter_value.strip()

    if args.only_id is not None:
        params["id"] = f"eq.{args.only_id}"
        try:
            rows = sb_select(sb_url, sb_key, table, params)
        except Exception as e:
            print(f"Abbruch: {e}")
            sys.exit(1)
        row_iter = rows
    else:
        if process_all:
            # Paginierter Abruf und sofortige Verarbeitung (kein Vorab-Laden aller Datensätze)
            def _row_generator():
                batch = max(1, min(args.limit, 1000))
                offset = 0
                total = 0
                while True:
                    params.clear()
                    params["limit"] = str(batch)
                    params["offset"] = str(offset)
                    if filter_field and filter_value:
                        params[filter_field] = f"eq.{filter_value}"
                    try:
                        page = sb_select(sb_url, sb_key, table, params) or []
                    except Exception:
                        _gentle_wait("Netzwerkproblem beim Seitenabruf")
                        try:
                            page = sb_select(sb_url, sb_key, table, params) or []
                        except Exception as ee:
                            print(f"Abbruch: {ee}")
                            sys.exit(1)
                    got = len(page)
                    total += got
                    print(f"Geladen: +{got} (gesamt {total}), offset={offset}")
                    for _r in page:
                        yield _r
                    if got < batch:
                        break
                    offset += batch
            row_iter = _row_generator()
        else:
            # Begrenzter Abruf anhand gewünschter Anzahl oder --limit
            limit_val = requested_count if requested_count is not None else args.limit
            offset_val = args.offset
            params["limit"] = str(limit_val)
            params["offset"] = str(offset_val)
            if filter_field and filter_value:
                params[filter_field] = f"eq.{filter_value}"
            try:
                rows = sb_select(sb_url, sb_key, table, params)
            except Exception as e:
                print(f"Abbruch: {e}")
                sys.exit(1)
            row_iter = rows

    processed_any = False

    for row in row_iter:
        processed_any = True
        row_id = row.get("id")
        questions_all = extract_questions(row)
        questions = [q for q in questions_all if not is_question_truly_empty(q)]
        if not questions:
            print(f"ID {row_id}: Nur vollständig leere Fragen vorhanden. Übersprungen.")
            continue
        if args.max_questions and len(questions) > args.max_questions:
            questions = questions[:args.max_questions]

        topic = " • ".join([str(row.get(x)) for x in ["Category", "Subcategory", "Titel"] if row.get(x)]) or "Allgemein"
        level = row.get("level") or ""
        language = row.get("Sprache") or ""
        description = row.get("Beschreibung") or ""

        # Icon prüfen und ggf. aktualisieren (Emoji, kein Text)
        try:
            current_icon_raw = row.get("Icon")
            current_icon = strip_asterisk_markup(current_icon_raw) if current_icon_raw is not None else None
            resp_icon = None
            last_icon_err = None
            for kk in range(3):
                try:
                    resp_icon = deepseek_audit_icon(
                        ds_base, ds_key, ds_model,
                        topic=topic, level=level, language=language,
                        description=description,
                        current_icon=(str(current_icon).strip() if current_icon is not None else None)
                    )
                    break
                except Exception as e:
                    last_icon_err = e
                    _gentle_wait("DeepSeek nicht erreichbar (Icon)")
                    time.sleep(1.0 * (kk + 1))
            if resp_icon and not last_icon_err:
                keep_flag = resp_icon.get("keep")
                if keep_flag is None:
                    keep_flag = resp_icon.get("ok")
                new_emoji = _first_emoji_candidate(resp_icon.get("emoji") or resp_icon.get("icon"))
                cur_ok = _is_single_emoji(current_icon) if current_icon is not None else False
                cur_trim = str(current_icon).strip() if current_icon is not None else ""
                if (keep_flag is True and cur_ok):
                    pass
                else:
                    if new_emoji and (not cur_ok or new_emoji != cur_trim):
                        try:
                            _ = sb_patch(sb_url, sb_key, table, row_id, {"Icon": new_emoji})
                            print(f"{GREEN}✔ Icon aktualisiert · ID {row_id}: {cur_trim or '∅'} -> {new_emoji}{RESET}")
                            row["Icon"] = new_emoji
                        except Exception as e:
                            print(f"{RED}✖ Icon-Update fehlgeschlagen (ID {row_id}): {e}{RESET}")
        except Exception:
            pass

        # Dedupe
        if args.dedupe:
            groups = find_duplicate_groups(questions, args.dedupe_threshold)
            qmap = {q["index"]: q for q in questions}
            for grp in groups:
                keeper_idx = grp[0]
                for dup_idx in grp[1:]:
                    kept_q = qmap[keeper_idx]
                    dup_q = qmap[dup_idx]
                    resp = None
                    last_err = None
                    for k in range(3):
                        try:
                            resp = deepseek_replace_duplicate(
                                ds_base, ds_key, ds_model,
                                topic, level, language,
                                description, kept_q, dup_q
                            )
                            break
                        except Exception as e:
                            last_err = e
                            _gentle_wait("DeepSeek nicht erreichbar")
                            time.sleep(1.2 * (k + 1))
                    if last_err:
                        print(f"{RED}ID {row_id}: Duplikat-Ersatz für Frage {dup_idx} fehlgeschlagen: {last_err}{RESET}")
                        continue

                    proposal = clean_proposal_text_fields(resp.get("proposal") or {})
                    entry = {
                        "index": resp.get("index", dup_idx),
                        "status": "revise",
                        "reason": resp.get("reason") or "Duplikat ersetzt",
                        "proposal": {
                            "q": proposal.get("q"),
                            "a1": proposal.get("a1"),
                            "a2": proposal.get("a2"),
                            "a3": proposal.get("a3"),
                            "a4": proposal.get("a4"),
                            "correct": proposal.get("correct"),
                        }
                    }

                    print_one_question_step(row, entry, is_duplicate_replacement=True)
                    log_path = log_proposal_step(row_id, entry, row)
                    print(f"{BLUE}🔷 Protokoll: {log_path}{RESET}")

                    ans = prompt_yes_no_quit("Duplikat ersetzen und Änderung übernehmen?")
                    if ans == "q":
                        print("Beendet.")
                        sys.exit(0)
                    if ans == "j":
                        payload = build_update_payload_for_one(entry["index"], entry["proposal"])
                        if payload:
                            try:
                                _ = sb_patch(sb_url, sb_key, table, row_id, payload)
                                print(f"{GREEN}✔ Duplikat ersetzt (ID {row_id}, Frage {entry['index']}){RESET}")
                                qmap[dup_idx]["q"] = entry["proposal"]["q"]
                                qmap[dup_idx]["a"] = [
                                    entry["proposal"]["a1"],
                                    entry["proposal"]["a2"],
                                    entry["proposal"]["a3"],
                                    entry["proposal"]["a4"],
                                ]
                                qmap[dup_idx]["correct"] = int(entry["proposal"]["correct"])
                            except Exception as e:
                                print(f"{RED}✖ Update fehlgeschlagen (ID {row_id}, Frage {entry['index']}): {e}{RESET}")
                        else:
                            print(f"{BLUE}Keine änderbaren Felder im Vorschlag.{RESET}")
                    else:
                        print(f"{YELLOW}↷ Duplikat-Ersatz verworfen (ID {row_id}, Frage {entry['index']}).{RESET}")

        # Normale Prüfung pro Frage
        for q in questions:
            resp = None
            last_err = None
            for k in range(3):
                try:
                    resp = deepseek_per_question(
                        ds_base, ds_key, ds_model,
                        topic=topic, level=level, language=language, description=description, q=q
                    )
                    break
                except Exception as e:
                    last_err = e
                    _gentle_wait("DeepSeek nicht erreichbar")
                    time.sleep(1.2 * (k + 1))
            if last_err:
                print(f"ID {row_id}: Frage {q['index']} DeepSeek-Fehler: {last_err}")
                continue

            entry = {
                "index": resp.get("index", q["index"]),
                "status": resp.get("status") or "",
                "reason": resp.get("reason"),
                "proposal": clean_proposal_text_fields(resp.get("proposal") or {})
            }

            if not _is_improvement(entry, q):
                continue

            status = entry["status"]
            prop = entry["proposal"]

            # Nur Fragetext geändert -> automatisch
            if _is_question_change_only(q, prop, status):
                payload = build_update_payload_for_one(entry["index"], {"q": prop.get("q")})
                try:
                    _ = sb_patch(sb_url, sb_key, table, row_id, payload)
                    print(f"{GREEN}✔ Automatisch aktualisiert (nur Frage) · ID {row_id}, Frage {entry['index']}{RESET}")
                except Exception as e:
                    print(f"{RED}✖ Auto-Update fehlgeschlagen (ID {row_id}, Frage {entry['index']}): {e}{RESET}")
                print_one_question_step(row, entry)
                log_path = log_proposal_step(row_id, entry, row)
                print(f"{BLUE}🔷 Protokoll: {log_path}{RESET}")
                time.sleep(0.2)
                continue

            # Antworten betroffen oder drop -> bestätigen
            print_one_question_step(row, entry)
            log_path = log_proposal_step(row_id, entry, row)
            print(f"{BLUE}🔷 Protokoll: {log_path}{RESET}")

            ans = prompt_yes_no_quit("Antworten/Struktur ändern. Änderungen übernehmen?")
            if ans == "q":
                print("Beendet.")
                sys.exit(0)
            if ans == "j":
                payload = build_update_payload_for_one(entry["index"], prop)
                if payload:
                    try:
                        _ = sb_patch(sb_url, sb_key, table, row_id, payload)
                        print(f"{GREEN}✔ Aktualisiert (ID {row_id}, Frage {entry['index']}): {list(payload.keys())}{RESET}")
                    except Exception as e:
                        print(f"{RED}✖ Update fehlgeschlagen (ID {row_id}, Frage {entry['index']}): {e}{RESET}")
                else:
                    print(f"{BLUE}Keine änderbaren Felder im Vorschlag.{RESET}")
            else:
                print(f"{YELLOW}↷ Übersprungen (ID {row_id}, Frage {entry['index']}).{RESET}")

            time.sleep(0.3)

    if not processed_any:
        print("Keine Datensätze gefunden.")
        sys.exit(0)

    print("Fertig.")

if __name__ == "__main__":
    main()
