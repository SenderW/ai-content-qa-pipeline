def load_secrets(reset: bool = False) -> Dict[str, str]:
    """
    Reihenfolge:
    1) Defaults (ohne Secrets)
    2) Umgebungsvariablen (überschreiben Defaults)
    3) secrets.json (optional, überschreibt alles)

    Validierung:
    - SUPABASE_URL, SUPABASE_KEY, DEEPSEEK_API_KEY müssen gesetzt sein.
    """
    cfg = DEFAULT_CONFIG.copy()

    # 1) Env
    for key, env_name in ENV_KEYS.items():
        val = os.getenv(env_name)
        if val:
            cfg[key] = val.strip()

    # 2) secrets.json (optional)
    if reset:
        # reset erstellt eine leere secrets.json Vorlage und beendet sich.
        if not os.path.exists(SECRETS_PATH):
            write_file(SECRETS_PATH, DEFAULT_CONFIG.copy())
        write_secrets_example(overwrite=True)
        print("secrets.json und secrets.example.json wurden (ohne Keys) erstellt/überschrieben.")
        print("Trage deine Keys lokal in secrets.json ein oder nutze Umgebungsvariablen.")
        sys.exit(0)

    if os.path.isfile(SECRETS_PATH):
        try:
            with open(SECRETS_PATH, "r", encoding="utf-8", errors="replace") as f:
                raw = f.read()
            try:
                data = json.loads(raw)
            except json.JSONDecodeError:
                data = json.loads(sanitize_json_text(raw))
                write_file(SECRETS_PATH, data)
                print("secrets.json repariert.")
            for k in REQUIRED_KEYS:
                if k in data and data[k] is not None and str(data[k]).strip() != "":
                    cfg[k] = str(data[k]).strip()
        except Exception as e:
            print(f"Fehler beim Laden von secrets.json: {e}")
            # cfg bleibt aus Env/Defaults

    # 3) Beispiel-Datei sicherstellen
    write_secrets_example()

    # 4) Validierung
    missing = []
    if not cfg.get("SUPABASE_URL"):
        missing.append("SUPABASE_URL")
    if not cfg.get("SUPABASE_KEY"):
        missing.append("SUPABASE_KEY")
    if not cfg.get("DEEPSEEK_API_KEY"):
        missing.append("DEEPSEEK_API_KEY")

    if missing:
        print(f"{RED}Fehlende Konfiguration: {', '.join(missing)}{RESET}")
        print("Setze die Werte als Umgebungsvariablen oder in einer lokalen secrets.json.")
        print("Beispiel (Linux/macOS):")
        print("  export SUPABASE_URL='https://xxxx.supabase.co'")
        print("  export SUPABASE_KEY='...'\n  export DEEPSEEK_API_KEY='sk-...'\n")
        print("Beispiel (Windows PowerShell):")
        print("  setx SUPABASE_URL \"https://xxxx.supabase.co\"")
        print("  setx SUPABASE_KEY \"...\"")
        print("  setx DEEPSEEK_API_KEY \"sk-...\"")
        sys.exit(2)

    return cfg

# Supabase
def sb_headers(api_key: str) -> Dict[str, str]:
    return {
        "apikey": api_key,
        "Authorization": f"Bearer {api_key}",
        "Content-Type": "application/json",
        "Accept": "application/json",
        "Prefer": "return=representation",
    }

def sb_select(url: str, api_key: str, table: str, params: Dict[str, str]) -> List[Dict[str, Any]]:
    endpoint = f"{url}/rest/v1/{table}"
    headers = sb_headers(api_key)
    params = {"select": "*", **params}
    last_err = None
    for k in range(3):
        try:
            r = requests.get(endpoint, headers=headers, params=params, timeout=60)
            if r.status_code != 200:
                raise RuntimeError(f"Supabase SELECT Fehler {r.status_code}: {r.text}")
            return r.json()
        except Exception as e:
            last_err = e
            _gentle_wait("Supabase nicht erreichbar")
            time.sleep(1.2 * (k + 1))
    raise RuntimeError(f"Supabase SELECT dauerhaft fehlgeschlagen: {last_err}")

def sb_patch(url: str, api_key: str, table: str, row_id: int, payload: Dict[str, Any]) -> Dict[str, Any]:
    endpoint = f"{url}/rest/v1/{table}"
    headers = sb_headers(api_key)
    params = {"id": f"eq.{row_id}"}
    last_err = None
    for k in range(3):
        try:
            r = requests.patch(endpoint, headers=headers, params=params, data=json.dumps(payload), timeout=60)
            if r.status_code not in (200, 204):
                raise RuntimeError(f"Supabase PATCH Fehler {r.status_code}: {r.text}")
            return r.json()[0] if r.text else {"id": row_id}
        except Exception as e:
            last_err = e
            _gentle_wait("Supabase nicht erreichbar")
            time.sleep(1.2 * (k + 1))
    raise RuntimeError(f"Supabase PATCH dauerhaft fehlgeschlagen: {last_err}")

# Fragen I/O
def extract_questions(row: Dict[str, Any]) -> List[Dict[str, Any]]:
    qmap: Dict[int, Dict[str, Any]] = {}
    for k, v in row.items():
        m_q = QUESTION_RE.match(k)
        m_a = ANS_RE.match(k)
        m_c = CORR_RE.match(k)
        if m_q:
            idx = int(m_q.group(1))
            qmap.setdefault(idx, {"index": idx, "q": None, "a": [None, None, None, None], "correct": None})
            qmap[idx]["q"] = v
        elif m_a:
            idx = int(m_a.group(1)); ai = int(m_a.group(2))
            if 1 <= ai <= 4:
                qmap.setdefault(idx, {"index": idx, "q": None, "a": [None, None, None, None], "correct": None})
                qmap[idx]["a"][ai - 1] = v
        elif m_c:
            idx = int(m_c.group(1))
            qmap.setdefault(idx, {"index": idx, "q": None, "a": [None, None, None, None], "correct": None})
            if isinstance(v, (int, float, str)) and str(v).strip().isdigit():
                qmap[idx]["correct"] = int(str(v).strip())
            else:
                qmap[idx]["correct"] = None
    return [qmap[i] for i in sorted(qmap.keys())]

def build_update_payload_for_one(index: int, prop: Dict[str, Any]) -> Dict[str, Any]:
    payload: Dict[str, Any] = {}
    if prop.get("q") is not None:
        payload[f"Frage{index}"] = prop["q"]
    for i, key in enumerate(["a1", "a2", "a3", "a4"], start=1):
        if prop.get(key) is not None:
            payload[f"Frage{index}-Antwort-{i}"] = prop[key]
    if prop.get("correct") is not None:
        payload[f"Frage{index}-Antwort-richtig"] = int(prop["correct"])
    return payload

# DeepSeek Kern
def balanced_json_extract(s: str) -> Optional[str]:
    stack = 0
    end = None
    for i in range(len(s)-1, -1, -1):
        ch = s[i]
        if ch == "}":
            if stack == 0:
                end = i + 1
            stack += 1
        elif ch == "{":
            stack -= 1
            if stack == 0 and end is not None:
                return s[i:end]
    return None

def ds_request(base_url: str, api_key: str, model: str, system_msg: str, user_payload: dict, timeout_s: int = 120) -> dict:
    url = f"{base_url}/v1/chat/completions"
    headers = {"Authorization": f"Bearer {api_key}", "Content-Type": "application/json"}
    body = {
        "model": model,
        "messages": [
            {"role": "system", "content": system_msg},
            {"role": "user", "content": json.dumps(user_payload, ensure_ascii=False)}
        ],
        "temperature": 0.1,
        "response_format": {"type": "json_object"}
    }
    r = requests.post(url, headers=headers, data=json.dumps(body), timeout=timeout_s)
    if r.status_code == 401:
        raise PermissionError(f"401 Authentication Error. Verwendeter Key: {mask(api_key)}")
    if r.status_code in (429, 500, 502, 503, 504):
        raise RuntimeError(f"Transienter Fehler {r.status_code}: {r.text}")
    if r.status_code != 200:
        raise RuntimeError(f"DeepSeek Fehler {r.status_code}: {r.text}")
    data = r.json()
    content = data.get("choices", [{}])[0].get("message", {}).get("content")
    if not content:
        raise RuntimeError("Leere Antwort von DeepSeek.")
    try:
        return json.loads(content)
    except json.JSONDecodeError:
        extracted = balanced_json_extract(content or "")
        if extracted:
            return json.loads(extracted)
        raise RuntimeError("DeepSeek-Antwort war kein valides JSON.")

