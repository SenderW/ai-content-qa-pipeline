CONTROL_CHAR_PATTERN = re.compile(r"[\x00-\x08\x0B\x0C\x0E-\x1F]")
QUESTION_RE = re.compile(r"^Frage(\d+)$")
ANS_RE = re.compile(r"^Frage(\d+)-Antwort-(\d+)$")
CORR_RE = re.compile(r"^Frage(\d+)-Antwort-richtig$")

# Utils
def mask(s: str) -> str:
    if not s:
        return ""
    if len(s) <= 8:
        return "*" * len(s)
    return f"{s[:4]}***{s[-4:]}"

def ts() -> str:
    return datetime.now().strftime("%Y%m%d-%H%M%S")

def sanitize_json_text(txt: str) -> str:
    txt = txt.replace("\ufeff", "")
    return CONTROL_CHAR_PATTERN.sub("", txt)

# Entfernt Sternchen-Markierungen wie *Beispiel* oder **Beispiel** (ohne Multiplikations-Sternchen 2*3 anzutasten)
ASTERISK_BOLD_RE = re.compile(r"\*\*([^*\n]+?)\*\*")
ASTERISK_ITALIC_RE = re.compile(r"\*([^*\n]+?)\*")
ASTERISK_STRAY_RE = re.compile(r"(?<!\d)\*(?!\d)")

def strip_asterisk_markup(s: Optional[str]) -> Optional[str]:
    if s is None:
        return None
    x = str(s)
    x = ASTERISK_BOLD_RE.sub(r"\1", x)
    x = ASTERISK_ITALIC_RE.sub(r"\1", x)
    x = ASTERISK_STRAY_RE.sub("", x)
    return x

def clean_proposal_text_fields(prop: Dict[str, Any]) -> Dict[str, Any]:
    if not isinstance(prop, dict):
        return {}
    out: Dict[str, Any] = dict(prop)
    for k in ("q", "a1", "a2", "a3", "a4"):
        if k in out and out[k] is not None:
            out[k] = strip_asterisk_markup(out[k])
    return out

def _is_single_emoji(s: Optional[str]) -> bool:
    if s is None:
        return False
    x = str(s).strip()
    if not x:
        return False
    if any(ch.isspace() for ch in x):
        return False
    for ch in x:
        cat = unicodedata.category(ch)
        if cat and (cat[0] == "L" or cat[0] == "N"):
            return False
    if len(x) > 12:
        return False
    return True

def _first_emoji_candidate(s: Optional[str]) -> Optional[str]:
    if s is None:
        return None
    x = strip_asterisk_markup(str(s)).strip()
    if not x:
        return None
    tok = x.split()[0]
    tok = tok.strip(" \"'“”„‚’`")
    if _is_single_emoji(tok):
        return tok
    cleaned = "".join(ch for ch in tok if not ch.isalnum())
    cleaned = cleaned.strip()
    if _is_single_emoji(cleaned):
        return cleaned
    return None

def write_file(path: str, data: dict) -> None:
    with open(path, "w", encoding="utf-8") as f:
        json.dump(data, f, ensure_ascii=False, indent=2)

def is_blank(x: Optional[str]) -> bool:
    return x is None or str(x).strip() == ""

def is_question_truly_empty(q: Dict[str, Any]) -> bool:
    no_q = is_blank(q.get("q"))
    a = q.get("a") or [None, None, None, None]
    all_empty_answers = all(is_blank(ai) for ai in a)
    return no_q and all_empty_answers

def norm_text(s: Optional[str]) -> str:
    if not s:
        return ""
    s = s.lower()
    s = re.sub(r"\(stand[^)]*\)", "", s)  # entfernt explizit deutsche "Stand(...)"-Zusätze für Dedupe
    s = re.sub(r"\([^)]*\bversion\b[^)]*\)", "", s)
    s = re.sub(r"\s+", " ", s)
    return s.strip()

def sim(a: str, b: str) -> float:
    return SequenceMatcher(None, a, b).ratio()

